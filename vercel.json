{
  "rewrites": [
    {
      "source": "/control",
      "destination": "https://website-live-bymsr.vercel.app"
    },
    {
      "source": "/control/:path*",
      "destination": "https://website-live-bymsr.vercel.app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://website-live-bymsr.vercel.app/api/:path*"
    }
  ]
}
